    "# Campaign Response Analysis\n",
    "campaign_response = responses.merge(\n",
    "    campaigns[[\"Campaign_ID\", \"Campaign_Name\", \"Channel\"]],\n",
    "    on = \"Campaign_ID\",\n",
    "    how = \"left\"\n",
    ")\n",
    "\n",
    "campaign_response_analysis = campaign_response.groupby(\n",
    "    [\"Campaign_ID\", \"Campaign_Name\", \"Channel\"]\n",
    ").agg(\n",
    "    Responses = (\"Response_ID\", \"count\"),\n",
    "    Conversions = (\"Converted\", \"sum\")\n",
    ").reset_index()\n",
    "\n",
    "campaign_response_analysis[\"Conversion_Rate\"] = (\n",
    "    campaign_response_analysis[\"Conversions\"] /\n",
    "    campaign_response_analysis[\"Responses\"]\n",
    ") * 100\n",
    "\n",
    "campaign_response_analysis = campaign_response_analysis.sort_values(\n",
    "    \"Conversion_Rate\",\n",
    "    ascending = False\n",
    ")\n",
    "\n",
    "campaign_response_analysis"
   ]
  },
