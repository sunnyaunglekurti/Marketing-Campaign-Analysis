   "source": [
    "# Which customers are responding and converting from Novacart's marketing campaigns?\n",
    "# Customer Segment vs Conversiom\n",
    "\n",
    "segment_analysis = responses.merge(\n",
    "    customers[[\"Customer_ID\", \"Customer_Segment\"]],\n",
    "    on = \"Customer_ID\",\n",
    "    how = \"left\"\n",
    ")\n",
    "\n",
    "segment_performance = segment_analysis.groupby(\n",
    "    \"Customer_Segment\"\n",
    ").agg(\n",
    "    Total_Responses = (\"Response_ID\", \"count\"),\n",
    "    Conversions = (\"Converted\", \"sum\")\n",
    ").reset_index()\n",
    "\n",
    "segment_performance[\"Conversion_Rate\"] = (\n",
    "    segment_performance[\"Conversions\"] /\n",
    "    segment_performance[\"Total_Responses\"]\n",
    ") * 100\n",
    "\n",
    "segment_performance = segment_performance.sort_values(\n",
    "    \"Conversion_Rate\",\n",
    "    ascending = False\n",
    ")\n",
    "\n",
    "segment_performance"
   ]
