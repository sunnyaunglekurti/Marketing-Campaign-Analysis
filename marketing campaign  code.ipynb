    "customer_value = transactions.groupby(\n",
    "    \"Customer_ID\"\n",
    ").agg(\n",
    "    Total_Spend = (\"Net_Revenue_INR\", \"sum\"),\n",
    "    Total_Transactions = (\"Transaction_ID\", \"count\"),\n",
    "    Average_Order_Value = (\"Net_Revenue_INR\", \"mean\"),\n",
    "    Last_Purchase_Date = (\"Transaction_Date\", \"max\")\n",
    ").reset_index()\n",
    "\n",
    "customer_value.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "295101ff-27b6-4010-869d-664dab044cc6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert date columns to datetime\n",
    "transactions[\"Transaction_Date\"] = pd.to_datetime(\n",
    "    transactions[\"Transaction_Date\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "customer_value[\"Last_Purchase_Date\"] = pd.to_datetime(\n",
    "    customer_value[\"Last_Purchase_Date\"],\n",
    "    errors=\"coerce\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "4f3c684f-ba4b-4e37-b7f9-a6d33ff15699",
   "metadata": {},
   "outputs": [],
   "source": [
    "# calculate recency:\n",
    "analysis_date = transactions[\"Transaction_Date\"].max()\n",
    "\n",
    "customer_value[\"Recency_Days\"] = (\n",
    "    analysis_date - \n",
    "    customer_value[\"Last_Purchase_Date\"]\n",
    ").dt.days"
   ]
  },
