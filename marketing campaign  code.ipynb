    "import pandas as pd\n",
    "from sqlalchemy import create_engine\n",
    "\n",
    "username = \"root\"\n",
    "password = \"root\"\n",
    "host = \"localhost\"\n",
    "database = \"marketing_campaign\"\n",
    "\n",
    "engine = create_engine(\n",
    "    f\"mysql+pymysql://{username}:{password}@{host}/{database}\"\n",
    ")\n",
    "\n",
    "print(\"Connection successful!\")"
   ]
  },
