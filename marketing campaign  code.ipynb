   "source": [
    "# Performance by channel\n",
    "channel_performance = marketing.groupby(\"Channel\").agg({\n",
    "    \"Spend_INR\": \"sum\",\n",
    "    \"Impressions\": \"sum\",\n",
    "    \"Clicks\": \"sum\",\n",
    "    \"Conversions\": \"sum\",\n",
    "    \"Revenue_INR\": \"sum\"\n",
    "}).reset_index()\n",
    "\n",
    "channel_performance[\"CTR\"] = (\n",
    "    channel_performance[\"Clicks\"] /\n",
    "    channel_performance[\"Impressions\"]\n",
    ") * 100\n",
    "\n",
    "channel_performance[\"Conversion_Rate\"] = (\n",
    "    channel_performance[\"Conversions\"] /\n",
    "    channel_performance[\"Clicks\"]\n",
    ") * 100\n",
    "\n",
    "channel_performance[\"ROAS\"] = (\n",
    "    channel_performance[\"Revenue_INR\"] /\n",
    "    channel_performance[\"Spend_INR\"]\n",
    ")\n",
    "\n",
    "channel_performance"
   ]
  },
