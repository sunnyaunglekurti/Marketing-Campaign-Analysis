   "source": [
    "campaign_funnel = marketing.groupby(\n",
    "    [\"Campaign_ID\", \"Campaign_Name\", \"Channel\"]\n",
    ").agg(\n",
    "    Impressions = (\"Impressions\", \"sum\"),\n",
    "    Clicks = (\"Clicks\", \"sum\"),\n",
    "    Conversions = (\"Conversions\", \"sum\"),\n",
    "    Spend = (\"Spend_INR\", \"sum\"),\n",
    "    Revenue = (\"Revenue_INR\", \"sum\")\n",
    ").reset_index()\n",
    "\n",
    "campaign_funnel[\"CTR\"] = (\n",
    "    campaign_funnel[\"Clicks\"] /\n",
    "    campaign_funnel[\"Impressions\"]\n",
    ") * 100\n",
    "\n",
    "campaign_funnel[\"Clicks_to_Conversion\"] = (\n",
    "    campaign_funnel[\"Conversions\"] / \n",
    "    campaign_funnel[\"Clicks\"]\n",
    ") * 100\n",
    "\n",
    "campaign_funnel[\"ROAS\"] = (\n",
    "    campaign_funnel[\"Revenue\"] / \n",
    "    campaign_funnel[\"Spend\"]\n",
    ")\n",
    "\n",
    "campaign_funnel.sort_values(\n",
    "    \"ROAS\",\n",
    "    ascending = False\n",
    ")"
   ]
