    "    [\"Campaign_ID\", \"Campaign_Name\", \"Channel\"]\n",
    ").agg({\n",
    "    \"Spend_INR\": \"sum\",\n",
    "    \"Impressions\": \"sum\",\n",
    "    \"Clicks\": \"sum\",\n",
    "    \"Conversions\": \"sum\",\n",
    "    \"Revenue_INR\": \"sum\"\n",
    "}).reset_index()\n",
    "\n",
    "campaign_performance[\"ROAS\"] = (\n",
    "    campaign_performance[\"Revenue_INR\"] /\n",
    "    campaign_performance[\"Spend_INR\"]\n",
    ")\n",
    "\n",
    "campaign_performance[\"ROI\"] = (\n",
    "    (campaign_performance[\"Revenue_INR\"] -\n",
    "    campaign_performance[\"Spend_INR\"])\n",
    "    / campaign_performance[\"Spend_INR\"]\n",
    ") * 100\n",
    "\n",
    "campaign_performance.sort_values(\n",
    "    \"ROAS\",\n",
    "    ascending = False\n",
    ")"
   ]
