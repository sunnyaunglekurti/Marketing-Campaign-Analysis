   "outputs": [],
   "source": [
    "# Create RFM Scores\n",
    "customer_value[\"R_Score\"] = pd.qcut(\n",
    "    customer_value[\"Recency_Days\"],\n",
    "    5,\n",
    "    labels=[5, 4, 3, 2, 1]\n",
    ")\n",
    "\n",
    "customer_value[\"F_Score\"] = pd.qcut(\n",
    "    customer_value[\"Total_Transactions\"].rank(method=\"first\"),\n",
    "    5,\n",
    "    labels=[1, 2, 3, 4, 5]\n",
    ")\n",
    "\n",
    "customer_value[\"M_Score\"] = pd.qcut(\n",
    "    customer_value[\"Total_Spend\"].rank(method=\"first\"),\n",
    "    5,\n",
    "    labels=[1, 2, 3, 4, 5]\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "0dfe17f8-d190-4f3e-9219-ad58a6d26ddf",
   "metadata": {},
   "outputs": [],
   "source": [
    "customer_value[\"RFM_Score\"] = (\n",
    "    customer_value[\"R_Score\"].astype(int) +\n",
    "    customer_value[\"F_Score\"].astype(int) +\n",
    "    customer_value[\"M_Score\"].astype(int)\n",
    ")"
   ]
  },
