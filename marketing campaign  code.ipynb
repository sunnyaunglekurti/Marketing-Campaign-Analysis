   "source": [
    "# Analysis - Funnel by Channel\n",
    "\n",
    "channel_funnel = marketing.groupby(\"Channel\").agg(\n",
    "    Impressions = (\"Impressions\", \"sum\"),\n",
    "    Clicks = (\"Clicks\", \"sum\"),\n",
    "    Conversions = (\"Conversions\", \"sum\")\n",
    ").reset_index()\n",
    "\n",
    "channel_funnel[\"CTR\"] = (\n",
    "    channel_funnel[\"Clicks\"] /\n",
    "    channel_funnel[\"Impressions\"]\n",
    ") * 100\n",
    "\n",
    "channel_funnel[\"Click_to_Conversion\"] = (\n",
    "    channel_funnel[\"Conversions\"] /\n",
    "    channel_funnel[\"Clicks\"]\n",
    ") * 100\n",
    "\n",
    "channel_funnel"
   ]
  },
