  {
   "cell_type": "markdown",
   "id": "c4ea0b9d-60b2-4632-acdd-674225ef6594",
   "metadata": {},
   "source": [
    "# Customer Segment vs Revenue"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "id": "88deaf3f-0099-43f5-bf13-fbbe83d69389",
   "metadata": {},
   "outputs": [],
   "source": [
    "customer_analysis = customer_value.merge(\n",
    "    customers[[\"Customer_ID\", \"Customer_Segment\"]],\n",
    "    on = \"Customer_ID\",\n",
    "    how = \"left\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "1b3021f7-3765-4791-b6c3-fd4ba5086707",
   "metadata": {},
   "outputs": [],
   "source": [
    "segment_value = customer_analysis.groupby(\n",
    "    \"Customer_Segment\"\n",
    ").agg(\n",
    "    Customers = (\"Customer_ID\", \"count\"),\n",
    "    Total_Revenue = (\"Total_Spend\", \"sum\"),\n",
    "    Avg_Spend = (\"Total_Spend\", \"mean\"),\n",
    "    Avg_Transactions = (\"Total_Transactions\", \"mean\"),\n",
    "    Avg_Order_Value = (\"Average_Order_Value\", \"mean\"),\n",
    "    Avg_Recency = (\"Recency_Days\", \"mean\")\n",
    ").reset_index()"
   ]
  },
